+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_CYCLE_DIRECTIONAL_H
+#define LABWC_CYCLE_DIRECTIONAL_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <wlr/util/box.h>
+
+enum lab_directional_cycle_dir {
+	LAB_DIRECTIONAL_CYCLE_NORTH,
+	LAB_DIRECTIONAL_CYCLE_SOUTH,
+	LAB_DIRECTIONAL_CYCLE_EAST,
+	LAB_DIRECTIONAL_CYCLE_WEST,
+};
+
+struct directional_cycle_distance {
+	int64_t axis;
+	int64_t perpendicular;
+	uint64_t focus_id;
+};
+
+/* Centers are measured in half-pixels to preserve odd window sizes. */
+bool directional_cycle_get_distance(const struct wlr_box *from,
+	const struct wlr_box *to, enum lab_directional_cycle_dir direction,
+	uint64_t focus_id, struct directional_cycle_distance *distance);
+
+/* Prefer axis distance, then perpendicular distance, then recent focus. */
+bool directional_cycle_is_closer(const struct directional_cycle_distance *a,
+	const struct directional_cycle_distance *b);
+
+#endif /* LABWC_CYCLE_DIRECTIONAL_H */
