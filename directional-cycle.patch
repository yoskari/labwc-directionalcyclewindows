diff --git a/src/cycle/directional.c b/src/cycle/directional.c
new file mode 100644
index 00000000..081a7e33
--- /dev/null
+++ b/src/cycle/directional.c
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "cycle-directional.h"
+
+bool
+directional_cycle_get_distance(const struct wlr_box *from,
+		const struct wlr_box *to, enum lab_directional_cycle_dir direction,
+		uint64_t focus_id, struct directional_cycle_distance *distance)
+{
+	if (from->width <= 0 || from->height <= 0
+			|| to->width <= 0 || to->height <= 0) {
+		return false;
+	}
+
+	int64_t dx = (int64_t)to->x * 2 + to->width
+		- ((int64_t)from->x * 2 + from->width);
+	int64_t dy = (int64_t)to->y * 2 + to->height
+		- ((int64_t)from->y * 2 + from->height);
+	int64_t axis, perpendicular;
+	switch (direction) {
+	case LAB_DIRECTIONAL_CYCLE_NORTH:
+		axis = -dy;
+		perpendicular = dx;
+		break;
+	case LAB_DIRECTIONAL_CYCLE_SOUTH:
+		axis = dy;
+		perpendicular = dx;
+		break;
+	case LAB_DIRECTIONAL_CYCLE_EAST:
+		axis = dx;
+		perpendicular = dy;
+		break;
+	case LAB_DIRECTIONAL_CYCLE_WEST:
+		axis = -dx;
+		perpendicular = dy;
+		break;
+	default:
+		return false;
+	}
+	if (axis <= 0) {
+		return false;
+	}
+	*distance = (struct directional_cycle_distance) {
+		.axis = axis,
+		.perpendicular = perpendicular < 0 ? -perpendicular : perpendicular,
+		.focus_id = focus_id,
+	};
+	return true;
+}
+
+bool
+directional_cycle_is_closer(const struct directional_cycle_distance *a,
+		const struct directional_cycle_distance *b)
+{
+	if (a->axis != b->axis) {
+		return a->axis < b->axis;
+	}
+	if (a->perpendicular != b->perpendicular) {
+		return a->perpendicular < b->perpendicular;
+	}
+	return a->focus_id > b->focus_id;
+}
