diff --git a/t/directional-cycle-client.c b/t/directional-cycle-client.c
new file mode 100644
index 00000000..c979615d
--- /dev/null
+++ b/t/directional-cycle-client.c
@@ -0,0 +1,359 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Headless integration client: real xdg windows and a virtual keyboard. */
+#define _GNU_SOURCE
+#include <assert.h>
+#include <linux/input-event-codes.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <wayland-client.h>
+#include <xkbcommon/xkbcommon.h>
+#include "virtual-keyboard-client-protocol.h"
+#include "xdg-shell-client-protocol.h"
+
+static struct wl_display *display;
+static struct wl_compositor *compositor;
+static struct wl_shm *shm;
+static struct wl_seat *seat;
+static struct xdg_wm_base *shell;
+static struct zwp_virtual_keyboard_manager_v1 *manager;
+static struct zwp_virtual_keyboard_v1 *keyboard;
+static unsigned int focused;
+
+struct window {
+	struct wl_surface *surface;
+	struct xdg_surface *xdg;
+	struct xdg_toplevel *toplevel;
+	struct wl_buffer *buffer;
+	unsigned int id;
+	bool mapped;
+};
+
+static struct window windows[4];
+
+static void
+sync_events(void)
+{
+	assert(wl_display_roundtrip(display) >= 0);
+	assert(wl_display_roundtrip(display) >= 0);
+}
+
+static void
+keymap(void *data, struct wl_keyboard *kb, uint32_t format, int fd, uint32_t size)
+{
+	close(fd);
+}
+
+static void
+enter(void *data, struct wl_keyboard *kb, uint32_t serial,
+		struct wl_surface *surface, struct wl_array *keys)
+{
+	focused = 0;
+	for (size_t i = 0; i < 4; ++i) {
+		if (windows[i].surface == surface) {
+			focused = windows[i].id;
+		}
+	}
+}
+
+static void
+leave(void *data, struct wl_keyboard *kb, uint32_t serial, struct wl_surface *surface)
+{
+	focused = 0;
+}
+
+static void
+key(void *data, struct wl_keyboard *kb, uint32_t serial,
+	uint32_t time, uint32_t code, uint32_t state)
+{
+}
+
+static void
+modifiers(void *data, struct wl_keyboard *kb, uint32_t serial,
+	uint32_t depressed, uint32_t latched, uint32_t locked, uint32_t group)
+{
+}
+
+static void
+repeat(void *data, struct wl_keyboard *kb, int32_t rate, int32_t delay)
+{
+}
+
+static const struct wl_keyboard_listener keyboard_listener = {
+	.keymap = keymap, .enter = enter, .leave = leave, .key = key,
+	.modifiers = modifiers, .repeat_info = repeat,
+};
+
+static void
+ping(void *data, struct xdg_wm_base *base, uint32_t serial)
+{
+	xdg_wm_base_pong(base, serial);
+}
+
+static const struct xdg_wm_base_listener shell_listener = { .ping = ping };
+
+static void
+global(void *data, struct wl_registry *registry, uint32_t name,
+		const char *interface, uint32_t version)
+{
+	if (!strcmp(interface, "wl_compositor")) {
+		compositor = wl_registry_bind(registry, name, &wl_compositor_interface, 4);
+	} else if (!strcmp(interface, "wl_shm")) {
+		shm = wl_registry_bind(registry, name, &wl_shm_interface, 1);
+	} else if (!strcmp(interface, "wl_seat")) {
+		seat = wl_registry_bind(registry, name, &wl_seat_interface, 5);
+	} else if (!strcmp(interface, "xdg_wm_base")) {
+		shell = wl_registry_bind(registry, name, &xdg_wm_base_interface, 1);
+	} else if (!strcmp(interface, "zwp_virtual_keyboard_manager_v1")) {
+		manager = wl_registry_bind(registry, name,
+			&zwp_virtual_keyboard_manager_v1_interface, 1);
+	}
+}
+
+static void
+global_remove(void *data, struct wl_registry *registry, uint32_t name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+	.global = global, .global_remove = global_remove,
+};
+
+static void
+configure(void *data, struct xdg_surface *surface, uint32_t serial)
+{
+	struct window *window = data;
+	xdg_surface_ack_configure(surface, serial);
+	if (!window->mapped) {
+		wl_surface_attach(window->surface, window->buffer, 0, 0);
+		wl_surface_damage(window->surface, 0, 0, 100, 100);
+		window->mapped = true;
+	}
+	wl_surface_commit(window->surface);
+}
+
+static const struct xdg_surface_listener surface_listener = { .configure = configure };
+
+static void
+toplevel_configure(void *data, struct xdg_toplevel *toplevel,
+	int32_t width, int32_t height, struct wl_array *states)
+{
+}
+
+static void
+toplevel_close(void *data, struct xdg_toplevel *toplevel)
+{
+}
+
+static const struct xdg_toplevel_listener toplevel_listener = {
+	.configure = toplevel_configure, .close = toplevel_close,
+};
+
+static void
+create_window(unsigned int index)
+{
+	struct window *window = &windows[index];
+	window->id = index + 1;
+	window->surface = wl_compositor_create_surface(compositor);
+	window->xdg = xdg_wm_base_get_xdg_surface(shell, window->surface);
+	xdg_surface_add_listener(window->xdg, &surface_listener, window);
+	window->toplevel = xdg_surface_get_toplevel(window->xdg);
+	xdg_toplevel_add_listener(window->toplevel, &toplevel_listener, window);
+	char name[32];
+	snprintf(name, sizeof(name), "directional-test-%u", window->id);
+	xdg_toplevel_set_app_id(window->toplevel, name);
+	xdg_toplevel_set_title(window->toplevel, name);
+	int fd = memfd_create("directional-test-buffer", 0);
+	assert(fd >= 0 && ftruncate(fd, 100 * 100 * 4) == 0);
+	struct wl_shm_pool *pool = wl_shm_create_pool(shm, fd, 100 * 100 * 4);
+	window->buffer = wl_shm_pool_create_buffer(pool, 0, 100, 100, 400,
+		WL_SHM_FORMAT_XRGB8888);
+	wl_shm_pool_destroy(pool);
+	close(fd);
+	wl_surface_commit(window->surface);
+	for (int i = 0; i < 10; ++i) {
+		sync_events();
+		usleep(10000);
+	}
+	assert(focused == window->id);
+}
+
+static void
+send_key(uint32_t code, bool pressed)
+{
+	static uint32_t time;
+	zwp_virtual_keyboard_v1_key(keyboard, ++time, code,
+		pressed ? WL_KEYBOARD_KEY_STATE_PRESSED : WL_KEYBOARD_KEY_STATE_RELEASED);
+	sync_events();
+}
+
+static void
+tap(uint32_t code)
+{
+	send_key(code, true);
+	send_key(code, false);
+}
+
+static void
+set_modifiers(bool super, bool shift)
+{
+	struct xkb_context *context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+	struct xkb_keymap *map = xkb_keymap_new_from_names(context, NULL,
+		XKB_KEYMAP_COMPILE_NO_FLAGS);
+	uint32_t mask = (super ? 1u << xkb_keymap_mod_get_index(map, XKB_MOD_NAME_LOGO) : 0)
+		| (shift ? 1u << xkb_keymap_mod_get_index(map, XKB_MOD_NAME_SHIFT) : 0);
+	zwp_virtual_keyboard_v1_modifiers(keyboard, mask, 0, 0, 0);
+	xkb_keymap_unref(map);
+	xkb_context_unref(context);
+	sync_events();
+}
+
+static void
+check_focus(unsigned int expected, const char *description)
+{
+	if (focused != expected) {
+		fprintf(stderr, "%s: expected focus %u, got %u\n", description, expected, focused);
+		exit(1);
+	}
+	printf("PASS: %s\n", description);
+}
+
+int
+main(void)
+{
+	display = wl_display_connect(NULL);
+	assert(display);
+	struct wl_registry *registry = wl_display_get_registry(display);
+	wl_registry_add_listener(registry, &registry_listener, NULL);
+	sync_events();
+	assert(compositor && shm && seat && shell && manager);
+	xdg_wm_base_add_listener(shell, &shell_listener, NULL);
+	keyboard = zwp_virtual_keyboard_manager_v1_create_virtual_keyboard(manager, seat);
+	struct xkb_context *context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+	struct xkb_keymap *map = xkb_keymap_new_from_names(context, NULL,
+		XKB_KEYMAP_COMPILE_NO_FLAGS);
+	char *text = xkb_keymap_get_as_string(map, XKB_KEYMAP_FORMAT_TEXT_V1);
+	int fd = memfd_create("directional-test-keymap", 0);
+	assert(fd >= 0 && write(fd, text, strlen(text) + 1) == (ssize_t)strlen(text) + 1);
+	zwp_virtual_keyboard_v1_keymap(keyboard, WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1,
+		fd, strlen(text) + 1);
+	close(fd);
+	free(text);
+	xkb_keymap_unref(map);
+	xkb_context_unref(context);
+	sync_events();
+	struct wl_keyboard *observer = wl_seat_get_keyboard(seat);
+	wl_keyboard_add_listener(observer, &keyboard_listener, NULL);
+	sync_events();
+	/* Three horizontal windows, then a fourth below the rightmost window. */
+	for (unsigned int i = 0; i < 4; ++i) {
+		create_window(i);
+	}
+	set_modifiers(true, false);
+	tap(KEY_UP);
+	check_focus(0, "selection does not focus before modifier release");
+	set_modifiers(false, false);
+	check_focus(3, "north commits the window above");
+	set_modifiers(true, false);
+	tap(KEY_RIGHT);
+	set_modifiers(false, false);
+	check_focus(3, "no candidate keeps current selection");
+	set_modifiers(true, false);
+	tap(KEY_LEFT);
+	tap(KEY_LEFT);
+	set_modifiers(false, false);
+	check_focus(1, "multiple presses step from the selection");
+	set_modifiers(true, false);
+	send_key(KEY_RIGHT, true);
+	usleep(1100000);
+	sync_events();
+	send_key(KEY_RIGHT, false);
+	set_modifiers(false, false);
+	check_focus(2, "holding a direction does not repeat");
+	set_modifiers(true, false);
+	tap(KEY_RIGHT);
+	tap(KEY_ESC);
+	set_modifiers(false, false);
+	check_focus(2, "Escape cancels without changing focus");
+	set_modifiers(true, false);
+	tap(KEY_RIGHT);
+	set_modifiers(true, true);
+	set_modifiers(false, true);
+	check_focus(0, "remaining modifier keeps selection open");
+	set_modifiers(false, false);
+	check_focus(3, "last modifier commits selection");
+	/* W-m minimizes the focused window, leaving window 2 focused. */
+	set_modifiers(true, false);
+	tap(KEY_M);
+	set_modifiers(false, false);
+	check_focus(2, "test window minimized");
+	set_modifiers(true, false);
+	tap(KEY_RIGHT);
+	set_modifiers(false, false);
+	check_focus(3, "minimized window is selected and restored on commit");
+	/* W-e selects west with an explicitly empty finalactions list. */
+	set_modifiers(true, false);
+	tap(KEY_E);
+	set_modifiers(false, false);
+	check_focus(3, "empty finalactions keeps original focus");
+	/* W-f selects west with Focus alone, replacing the defaults. */
+	set_modifiers(true, false);
+	tap(KEY_F);
+	set_modifiers(false, false);
+	check_focus(2, "custom finalactions focus the selected window");
+	set_modifiers(true, false);
+	tap(KEY_E);
+	tap(KEY_RIGHT);
+	set_modifiers(false, false);
+	check_focus(2, "first binding supplies finalactions throughout selection");
+	set_modifiers(true, false);
+	send_key(KEY_RIGHT, true);
+	set_modifiers(false, false);
+	check_focus(0, "modifier released first waits for the bound key release");
+	send_key(KEY_RIGHT, false);
+	check_focus(3, "releasing the bound key completes modifier-first selection");
+	set_modifiers(true, false);
+	tap(KEY_LEFT);
+	set_modifiers(false, false);
+	check_focus(2, "west returns to the middle window");
+	set_modifiers(true, false);
+	tap(KEY_E);
+	const char *server_pid = getenv("LABWC_TEST_SERVER_PID");
+	assert(server_pid && kill(atoi(server_pid), SIGHUP) == 0);
+	usleep(100000);
+	sync_events();
+	set_modifiers(false, false);
+	check_focus(2, "configuration reload cancels borrowed finalactions safely");
+	set_modifiers(true, false);
+	tap(KEY_RIGHT);
+	xdg_toplevel_destroy(windows[2].toplevel);
+	xdg_surface_destroy(windows[2].xdg);
+	wl_surface_destroy(windows[2].surface);
+	windows[2].surface = NULL;
+	sync_events();
+	set_modifiers(false, false);
+	check_focus(2, "closing the selected window cancels safely");
+	/* Alt-Tab still enters and commits ordinary cycling. */
+	uint32_t alt = 1u << 3; /* Mod1 in the default keymap. */
+	zwp_virtual_keyboard_v1_modifiers(keyboard, alt, 0, 0, 0);
+	sync_events();
+	tap(KEY_TAB);
+	check_focus(0, "ordinary Alt-Tab still opens selection");
+	set_modifiers(false, false);
+	assert(focused != 0);
+	puts("PASS: ordinary Alt-Tab still commits");
+	set_modifiers(true, false);
+	tap(KEY_U);
+	set_modifiers(false, false);
+	check_focus(0, "test clears keyboard focus");
+	set_modifiers(true, false);
+	tap(KEY_RIGHT);
+	set_modifiers(false, false);
+	check_focus(0, "no focused window does nothing");
+	wl_display_disconnect(display);
+	return 0;
+}
diff --git a/t/directional-cycle-integration.py b/t/directional-cycle-integration.py
new file mode 100644
index 00000000..b531e243
--- /dev/null
+++ b/t/directional-cycle-integration.py
@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Compile a Wayland test client and test labwc on an isolated headless output.
+
+Usage: python3 t/directional-cycle-integration.py build/labwc
+Requires cc, pkg-config, wayland-scanner, wayland-client and xkbcommon.
+"""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+
+# Only the virtual-keyboard requests used by the test client are needed.
+VIRTUAL_KEYBOARD = """<protocol name="virtual_keyboard_unstable_v1">
+  <interface name="zwp_virtual_keyboard_v1" version="1">
+    <request name="keymap"><arg name="format" type="uint"/>
+      <arg name="fd" type="fd"/><arg name="size" type="uint"/></request>
+    <request name="key"><arg name="time" type="uint"/>
+      <arg name="key" type="uint"/><arg name="state" type="uint"/></request>
+    <request name="modifiers"><arg name="mods_depressed" type="uint"/>
+      <arg name="mods_latched" type="uint"/><arg name="mods_locked" type="uint"/>
+      <arg name="group" type="uint"/></request>
+    <request name="destroy" type="destructor"/>
+  </interface>
+  <interface name="zwp_virtual_keyboard_manager_v1" version="1">
+    <request name="create_virtual_keyboard">
+      <arg name="seat" type="object" interface="wl_seat"/>
+      <arg name="id" type="new_id" interface="zwp_virtual_keyboard_v1"/>
+    </request>
+  </interface>
+</protocol>"""
+
+
+def main():
+    binary = Path(sys.argv[1]).resolve()
+    source = Path(__file__).with_name("directional-cycle-client.c").resolve()
+    with tempfile.TemporaryDirectory(prefix="labwc-directional-") as directory:
+        root = Path(directory)
+        runtime = root / "runtime"
+        runtime.mkdir(mode=0o700)
+        config = root / "config"
+        config.mkdir()
+        bindings = ""
+        for key, direction in [("Up", "north"), ("Down", "south"),
+                               ("Left", "west"), ("Right", "east")]:
+            bindings += (f'<keybind key="W-{key}"><action name="DirectionalCycleWindows">'
+                         f'<direction>{direction}</direction></action></keybind>')
+        rules = ""
+        for number, (x, y) in enumerate([(100, 100), (300, 100),
+                                        (500, 100), (500, 300)], start=1):
+            rules += (f'<windowRule identifier="directional-test-{number}">'
+                      f'<action name="MoveTo" x="{x}" y="{y}" /></windowRule>')
+        (config / "rc.xml").write_text(f"""<labwc_config>
+          <keyboard><repeatRate>50</repeatRate><repeatDelay>100</repeatDelay>
+            {bindings}
+            <keybind key="W-m"><action name="Iconify"/></keybind>
+            <keybind key="W-u"><action name="Unfocus"/></keybind>
+            <keybind key="W-e"><action name="DirectionalCycleWindows" direction="west">
+              <finalactions/></action></keybind>
+            <keybind key="W-f"><action name="DirectionalCycleWindows" direction="west">
+              <finalactions><action name="Focus"/></finalactions></action></keybind>
+            <keybind key="A-Tab"><action name="NextWindow"/></keybind>
+          </keyboard><windowRules>{rules}</windowRules>
+        </labwc_config>""")
+        (config / "autostart").write_text("")
+        (config / "shutdown").write_text("")
+        xml = root / "virtual-keyboard.xml"
+        xml.write_text(VIRTUAL_KEYBOARD)
+        protocols = subprocess.check_output(
+            ["pkg-config", "--variable=pkgdatadir", "wayland-protocols"], text=True).strip()
+        for name, path in [("virtual-keyboard", xml),
+                           ("xdg-shell", Path(protocols) / "stable/xdg-shell/xdg-shell.xml")]:
+            subprocess.run(["wayland-scanner", "client-header", str(path),
+                            str(root / f"{name}-client-protocol.h")], check=True)
+            subprocess.run(["wayland-scanner", "private-code", str(path),
+                            str(root / f"{name}-protocol.c")], check=True)
+        flags = subprocess.check_output(
+            ["pkg-config", "--cflags", "--libs", "wayland-client", "xkbcommon"],
+            text=True).split()
+        client = root / "client"
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Wno-unused-parameter",
+                        "-UNDEBUG", "-I", str(root), str(source),
+                        str(root / "xdg-shell-protocol.c"),
+                        str(root / "virtual-keyboard-protocol.c"), "-o", str(client),
+                        *flags], check=True)
+        env = dict(os.environ, XDG_RUNTIME_DIR=str(runtime), WAYLAND_DISPLAY="wayland-0",
+                   WLR_BACKENDS="headless", WLR_RENDERER="pixman",
+                   WLR_HEADLESS_OUTPUTS="1", LABWC_UPDATE_ACTIVATION_ENV="0",
+                   XKB_DEFAULT_LAYOUT="us", XKB_DEFAULT_VARIANT="",
+                   XKB_DEFAULT_OPTIONS="")
+        env.pop("WAYLAND_SOCKET", None)
+        with (root / "server.log").open("w+") as log:
+            server = subprocess.Popen([str(binary), "-C", str(config), "-d"],
+                                      env=env, stdout=log, stderr=log)
+            env["LABWC_TEST_SERVER_PID"] = str(server.pid)
+            try:
+                for _ in range(100):
+                    if (runtime / "wayland-0").exists() or server.poll() is not None:
+                        break
+                    time.sleep(0.05)
+                subprocess.run([str(client)], env=env, check=True, timeout=30)
+            except Exception:
+                log.seek(0)
+                print(log.read(), file=sys.stderr)
+                raise
+            finally:
+                server.terminate()
+                server.wait(timeout=10)
+            if server.returncode != 0:
+                raise RuntimeError(f"labwc exited with {server.returncode}")
+
+
+if __name__ == "__main__":
+    main()
