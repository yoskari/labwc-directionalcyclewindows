new file mode 100644
index 00000000..e8ff98a8
--- /dev/null
+++ b/t/directional-cycle.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <assert.h>
+#include <limits.h>
+#include <stddef.h>
+#include "cycle-directional.h"
+
+static void
+test_directions(void)
+{
+	struct wlr_box origin = { 100, 100, 100, 100 };
+	struct wlr_box targets[] = {
+		{ 100, 99, 100, 100 }, { 100, 101, 100, 100 },
+		{ 101, 100, 100, 100 }, { 99, 100, 100, 100 },
+	};
+	for (int direction = 0; direction < 4; ++direction) {
+		struct directional_cycle_distance distance;
+		assert(!directional_cycle_get_distance(&origin, &origin,
+			direction, 0, &distance));
+		for (int target = 0; target < 4; ++target) {
+			bool eligible = directional_cycle_get_distance(&origin,
+				&targets[target], direction, 7, &distance);
+			assert(eligible == (direction == target));
+			if (eligible) {
+				assert(distance.axis == 2);
+				assert(distance.perpendicular == 0);
+				assert(distance.focus_id == 7);
+			}
+		}
+	}
+}
+
+static void
+test_centers_and_extremes(void)
+{
+	struct wlr_box from = { 0, 0, 100, 100 };
+	struct wlr_box to = { -50, -50, 201, 201 };
+	struct directional_cycle_distance distance;
+	/* A containing, overlapping window can be half a pixel farther east. */
+	assert(directional_cycle_get_distance(&from, &to,
+		LAB_DIRECTIONAL_CYCLE_EAST, 0, &distance));
+	assert(distance.axis == 1 && distance.perpendicular == 1);
+	to.width = 200;
+	to.height = 200;
+	assert(!directional_cycle_get_distance(&from, &to,
+		LAB_DIRECTIONAL_CYCLE_EAST, 0, &distance));
+	to.width = 0;
+	assert(!directional_cycle_get_distance(&from, &to,
+		LAB_DIRECTIONAL_CYCLE_EAST, 0, &distance));
+	from = (struct wlr_box) { INT_MIN, INT_MIN, 1, 1 };
+	to = (struct wlr_box) { INT_MAX, INT_MAX, INT_MAX, INT_MAX };
+	assert(directional_cycle_get_distance(&from, &to,
+		LAB_DIRECTIONAL_CYCLE_EAST, 0, &distance));
+	assert(distance.axis > INT_MAX);
+	assert(distance.axis == distance.perpendicular);
+	assert(!directional_cycle_get_distance(&from, &to, -1, 0, &distance));
+}
+
+static void
+test_ranking(void)
+{
+	struct directional_cycle_distance a = { 1, 2000, 1 };
+	struct directional_cycle_distance b = { 2, 0, 9 };
+	assert(directional_cycle_is_closer(&a, &b));
+	assert(!directional_cycle_is_closer(&b, &a));
+	b.axis = 1;
+	assert(directional_cycle_is_closer(&b, &a));
+	a.perpendicular = 0;
+	assert(directional_cycle_is_closer(&b, &a));
+	a.focus_id = b.focus_id;
+	assert(!directional_cycle_is_closer(&a, &b));
+}
+
+static size_t
+select_next(const struct wlr_box *windows, size_t count, size_t selected,
+		enum lab_directional_cycle_dir direction)
+{
+	size_t best = selected;
+	struct directional_cycle_distance best_distance = {0}, distance;
+	for (size_t i = 0; i < count; ++i) {
+		if (directional_cycle_get_distance(&windows[selected], &windows[i],
+				direction, i, &distance)
+				&& (best == selected
+					|| directional_cycle_is_closer(&distance,
+						&best_distance))) {
+			best = i;
+			best_distance = distance;
+		}
+	}
+	return best;
+}
+
+static void
+test_navigation(void)
+{
+	struct wlr_box windows[] = {
+		{ -300, 0, 100, 100 },
+		{ -200, 2000, 100, 100 },
+		{ 0, 0, 100, 100 },
+		{ 0, 100, 100, 100 },
+	};
+	assert(select_next(windows, 4, 0, LAB_DIRECTIONAL_CYCLE_WEST) == 0);
+	assert(select_next(windows, 4, 0, LAB_DIRECTIONAL_CYCLE_EAST) == 1);
+	assert(select_next(windows, 4, 1, LAB_DIRECTIONAL_CYCLE_EAST) == 3);
+	assert(select_next(windows, 4, 3, LAB_DIRECTIONAL_CYCLE_EAST) == 3);
+	assert(select_next(windows, 4, 3, LAB_DIRECTIONAL_CYCLE_NORTH) == 2);
+	assert(select_next(windows, 4, 2, LAB_DIRECTIONAL_CYCLE_WEST) == 1);
+	assert(select_next(windows, 1, 0, LAB_DIRECTIONAL_CYCLE_EAST) == 0);
+}
+
+int
+main(void)
+{
+	test_directions();
+	test_centers_and_extremes();
+	test_ranking();
+	test_navigation();
+	return 0;
+}
