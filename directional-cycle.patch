+static bool
+directional_candidate(struct view *view)
+{
+	if (!view->surface || (!view->mapped && !view->minimized)
+			|| (!view->visible_on_all_workspaces
+				&& view->workspace != server.workspaces.current)) {
+		return false;
+	}
+	enum view_wants_focus wants_focus = view_wants_focus(view);
+	if (wants_focus != VIEW_WANTS_FOCUS_ALWAYS
+			&& wants_focus != VIEW_WANTS_FOCUS_LIKELY) {
+		return false;
+	}
+	/* Layer-shell panels are not views; exclude XWayland docks/desktops too. */
+	if (view->impl->contains_window_type
+			&& (view->impl->contains_window_type(view, LAB_WINDOW_TYPE_DOCK)
+				|| view->impl->contains_window_type(view,
+					LAB_WINDOW_TYPE_DESKTOP))) {
+		return false;
+	}
+	return true;
+}
+
+static void
+handle_directional_selected_destroy(struct wl_listener *listener, void *data)
+{
+	cycle_finish(/*switch_focus*/ false);
+}
+
+static void
+directional_select(struct view *view)
+{
+	struct cycle_state *cycle = &server.cycle;
+	if (cycle->selected_destroy.link.next) {
+		wl_list_remove(&cycle->selected_destroy.link);
+	}
+	cycle->selected_view = view;
+	cycle->selected_destroy.notify = handle_directional_selected_destroy;
+	wl_signal_add(&view->events.destroy, &cycle->selected_destroy);
+	update_preview_outlines(view);
+}
+
+void
+cycle_directional(enum lab_directional_cycle_dir direction,
+		struct wl_list *final_actions)
+{
+	struct cycle_state *cycle = &server.cycle;
+	if (server.input_mode == LAB_INPUT_STATE_PASSTHROUGH) {
+		if (!server.active_view || !directional_candidate(server.active_view)) {
+			return;
+		}
+		cycle->directional = true;
+		cycle->final_actions = final_actions;
+		directional_select(server.active_view);
+		seat_focus_override_begin(&server.seat,
+			LAB_INPUT_STATE_CYCLE, LAB_CURSOR_DEFAULT);
+		keyboard_cancel_all_keybind_repeats(&server.seat);
+	} else if (server.input_mode != LAB_INPUT_STATE_CYCLE || !cycle->directional) {
+		return;
+	}
+
+	struct view *best = NULL, *view;
+	struct directional_cycle_distance best_distance = {0}, distance;
+	wl_list_for_each(view, &server.views, link) {
+		if (view == cycle->selected_view || !directional_candidate(view)) {
+			continue;
+		}
+		if (!directional_cycle_get_distance(&cycle->selected_view->current,
+				&view->current, direction, view->focus_id, &distance)) {
+			continue;
+		}
+		if (!best || directional_cycle_is_closer(&distance, &best_distance)) {
+			best = view;
+			best_distance = distance;
+		}
+	}
+	if (best) {
+		directional_select(best);
+	}
+}
